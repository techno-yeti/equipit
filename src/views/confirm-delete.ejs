<%- include('partials/header', { title: 'Confirm Delete' }) %>
<%- include('partials/navbar') %>
<div class="max-w-md mx-auto">
  <div class="card p-8 text-center">
    <div class="w-14 h-14 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-4">
      <svg class="w-7 h-7 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"/></svg>
    </div>
    <h1 class="text-xl font-bold text-sidebar-text mb-2">Confirm Deletion</h1>
    <p class="text-sidebar-muted mb-6">Are you sure you want to delete <strong class="text-sidebar-text"><%= entityName %></strong>? This action cannot be undone.</p>
    <div class="flex items-center justify-center space-x-3">
      <a href="<%= cancelUrl %>" class="btn-secondary">Cancel</a>
      <form action="<%= deleteUrl %>" method="POST" class="inline">
        <button type="submit" class="btn-danger">
          <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
          Delete
        </button>
      </form>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
