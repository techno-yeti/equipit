<%- include('../partials/header', { title: equipment ? 'Edit Equipment' : 'Add Equipment' }) %>
<%- include('../partials/navbar') %>
<div class="max-w-lg mx-auto">
  <div class="card p-8">
    <h1 class="text-2xl font-bold text-sidebar-text mb-2"><%= equipment ? 'Edit Equipment Type' : 'Add Equipment Type' %></h1>
    <p class="text-sidebar-muted text-sm mb-6"><%= equipment ? 'Update the equipment type details' : 'Create a new equipment type for the system' %></p>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="mb-4 p-3 bg-red-50 border border-red-200 rounded-lg" role="alert">
        <p class="text-red-700 text-sm"><%= error %></p>
      </div>
    <% } %>

    <form action="<%= equipment ? '/equipment/' + equipment._id + '/edit' : '/equipment/create' %>" method="POST" class="space-y-4">
      <div>
        <label for="name" class="label">Equipment Name</label>
        <input type="text" id="name" name="name" class="input-field" value="<%= equipment ? equipment.name : '' %>" placeholder="e.g. Roll Cage" required>
      </div>
      <div>
        <label for="description" class="label">Description</label>
        <textarea id="description" name="description" rows="3" class="input-field" placeholder="Optional description"><%= equipment ? equipment.description : '' %></textarea>
      </div>
      <div class="flex items-center justify-end space-x-3 pt-4">
        <a href="/equipment" class="btn-secondary">Cancel</a>
        <button type="submit" class="btn-primary"><%= equipment ? 'Update' : 'Create' %></button>
      </div>
    </form>
  </div>
</div>
<%- include('../partials/footer') %>
