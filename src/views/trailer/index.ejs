<%- include('../partials/header', { title: 'Trailer Types' }) %>
<%- include('../partials/navbar') %>
<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="page-title">Trailer Types</h1>
      <p class="page-subtitle">Configure trailer types and their equipment capacities</p>
    </div>
    <% if (['admin', 'manager'].includes(user.role)) { %>
      <a href="/trailers/create" class="btn-primary">
        <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        Add Trailer
      </a>
    <% } %>
  </div>

  <div class="grid gap-4">
    <% if (trailers && trailers.length > 0) { %>
      <% trailers.forEach(function(t) { %>
        <div class="card p-6">
          <div class="flex items-center justify-between mb-4">
            <div>
              <h3 class="text-lg font-semibold text-sidebar-text"><%= t.label %></h3>
              <p class="text-sidebar-muted text-sm"><%= t.equipments.length %> equipment type(s) configured</p>
            </div>
            <div class="flex items-center space-x-2">
              <% if (['admin', 'manager'].includes(user.role)) { %>
                <a href="/trailers/<%= t._id %>/edit" class="btn-secondary !text-xs !px-3 !py-1.5">Edit</a>
              <% } %>
              <% if (user.role === 'admin') { %>
                <form action="/trailers/<%= t._id %>/delete" method="POST" class="inline">
                  <button type="submit" class="btn-danger !text-xs !px-3 !py-1.5" data-confirm="Delete this trailer type?">Delete</button>
                </form>
              <% } %>
            </div>
          </div>
          <div class="border-t border-surface-border pt-4">
            <table class="w-full text-sm">
              <thead>
                <tr class="text-left text-sidebar-muted text-xs uppercase tracking-wider">
                  <th class="pb-2 font-medium">Equipment</th>
                  <th class="pb-2 font-medium">Capacity</th>
                </tr>
              </thead>
              <tbody>
                <% t.equipments.forEach(function(eq) { %>
                  <tr>
                    <td class="py-1"><%= eq.equipmentType ? eq.equipmentType.name : 'Unknown' %></td>
                    <td class="py-1 font-medium"><%= eq.quantity %></td>
                  </tr>
                <% }); %>
                <% if (t.equipments.length === 0) { %>
                  <tr>
                    <td colspan="2" class="py-2 text-sidebar-muted italic">No equipment configured</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      <% }); %>
    <% } else { %>
      <div class="card p-8 text-center text-sidebar-muted">No trailer types defined yet.</div>
    <% } %>
  </div>
</div>
<%- include('../partials/footer') %>
