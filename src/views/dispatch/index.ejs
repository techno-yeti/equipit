<%- include('../partials/header', { title: 'Dispatch' }) %>
<%- include('../partials/navbar') %>
<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="page-title">Security Dispatch</h1>
      <p class="page-subtitle">Scan barcode to dispatch trailers with loaded equipment</p>
    </div>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="p-3 bg-red-50 border border-red-200 rounded-lg" role="alert">
      <p class="text-red-700 text-sm"><%= error %></p>
    </div>
  <% } %>

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="p-3 bg-green-50 border border-green-200 rounded-lg" role="alert">
      <p class="text-green-700 text-sm"><%= success %></p>
    </div>
  <% } %>

  <div class="card p-8">
    <div class="text-center mb-6">
      <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-3">
        <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"/>
        </svg>
      </div>
      <h2 class="text-xl font-semibold text-sidebar-text mb-2">Scan Barcode</h2>
      <p class="text-sidebar-muted text-sm">Scan the barcode from the equipment request paperwork</p>
    </div>

    <form action="/dispatch/scan" method="POST" class="max-w-md mx-auto">
      <div class="flex items-center space-x-2">
	        <input type="text" id="barcode" name="barcode" class="input-field text-center font-mono text-lg uppercase" placeholder="Scan or type barcode" maxlength="6" autofocus>
        <button type="submit" class="btn-primary !px-6">Dispatch</button>
      </div>
      <p class="text-xs text-sidebar-muted text-center mt-2">Barcode scanners typically input the number followed by Enter</p>
    </form>
  </div>

  <div class="card">
    <div class="px-6 py-4 border-b border-surface-border">
      <h2 class="text-lg font-semibold text-sidebar-text">Recent Requests</h2>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="bg-surface text-left">
            <th class="px-6 py-3 font-medium text-sidebar-muted text-xs uppercase tracking-wider">Request #</th>
            <th class="px-6 py-3 font-medium text-sidebar-muted text-xs uppercase tracking-wider">Status</th>
            <th class="px-6 py-3 font-medium text-sidebar-muted text-xs uppercase tracking-wider">Supplier</th>
            <th class="px-6 py-3 font-medium text-sidebar-muted text-xs uppercase tracking-wider">Depot</th>
            <th class="px-6 py-3 font-medium text-sidebar-muted text-xs uppercase tracking-wider">Updated</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-surface-border">
          <% if (requests && requests.length > 0) { %>
            <% requests.forEach(function(r) { %>
              <tr class="hover:bg-surface">
                <td class="px-6 py-4 font-mono font-bold tracking-widest">••••••</td>
                <td class="px-6 py-4">
                  <% if (r.status === 'pending') { %>
                    <span class="badge-pending">Pending</span>
                  <% } else if (r.status === 'fulfilled') { %>
                    <span class="badge-fulfilled">Fulfilled</span>
                  <% } else if (r.status === 'dispatched') { %>
                    <span class="badge-dispatched">Dispatched</span>
                  <% } %>
                </td>
                <td class="px-6 py-4"><%= r.supplier || 'N/A' %></td>
                <td class="px-6 py-4"><%= r.depotSite ? r.depotSite.name : '-' %></td>
                <td class="px-6 py-4 text-sidebar-muted"><%= new Date(r.updatedAt).toLocaleDateString('en-GB') %></td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="5" class="px-6 py-8 text-center text-sidebar-muted">No requests found.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
