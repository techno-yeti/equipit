<%- include('partials/header', { title: 'Login' }) %>
<%- include('partials/navbar') %>

<div class="flex items-center justify-center py-12">
  <div class="w-full max-w-md">
    <div class="card p-8">
      <div class="text-center mb-8">
        <div class="w-12 h-12 bg-equipit-green rounded-xl flex items-center justify-center mx-auto mb-3">
          <span class="text-white font-bold text-xl">E</span>
        </div>
        <h1 class="text-2xl font-bold text-sidebar-text">Welcome Back</h1>
        <p class="text-sidebar-muted text-sm mt-1">Sign in to your Equipit account</p>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="mb-4 p-3 bg-red-50 border border-red-200 rounded-lg" role="alert">
          <p class="text-red-700 text-sm"><%= error %></p>
        </div>
      <% } %>

      <form action="/login" method="POST" class="space-y-4">
        <div>
          <label for="email" class="label">Email</label>
          <input type="email" id="email" name="email" class="input-field" placeholder="you@example.com" required autocomplete="email">
        </div>
        <div>
          <label for="password" class="label">Password</label>
          <input type="password" id="password" name="password" class="input-field" placeholder="Enter your password" required autocomplete="current-password">
        </div>
        <button type="submit" class="btn-primary w-full !py-2.5">Sign In</button>
      </form>

      <p class="text-center text-sm text-sidebar-muted mt-6">
        Don't have an account? <a href="/register" class="text-primary-600 hover:text-primary-700 font-medium">Register here</a>
      </p>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
