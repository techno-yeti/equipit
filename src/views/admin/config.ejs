<%- include('../partials/header', { title: 'Settings' }) %>
<%- include('../partials/navbar') %>

<div class="max-w-2xl mx-auto space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="page-title">Settings</h1>
      <p class="page-subtitle">Configure domain restrictions for registration</p>
    </div>
  </div>

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="p-3 bg-emerald-50 border border-emerald-200 rounded-lg" role="alert">
      <p class="text-emerald-700 text-sm"><%= success %></p>
    </div>
  <% } %>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="p-3 bg-red-50 border border-red-200 rounded-lg" role="alert">
      <p class="text-red-700 text-sm"><%= error %></p>
    </div>
  <% } %>

  <form action="/admin/config" method="POST" class="space-y-6">
    <div class="card p-6">
      <h2 class="text-lg font-semibold text-sidebar-text mb-1">Allowed Domains</h2>
      <p class="text-sm text-sidebar-muted mb-4">
        Only users with email addresses from these domains will be able to register.
        Leave empty to allow all domains. One domain per line.
      </p>

      <div>
        <label for="domains" class="label">Allowed Domains</label>
        <textarea id="domains" name="domains" rows="6" class="input-field font-mono" placeholder="example.com&#10;mycompany.org"><%= typeof domains !== 'undefined' && domains ? domains.join('\n') : '' %></textarea>
      </div>

      <% if (typeof domains !== 'undefined' && domains && domains.length > 0) { %>
        <div class="mt-4 pt-4 border-t border-surface-border">
          <h3 class="text-sm font-medium text-sidebar-text mb-2">Currently allowed domains:</h3>
          <div class="flex flex-wrap gap-2">
            <% domains.forEach(function(d) { %>
              <span class="inline-flex items-center rounded-full bg-primary-50 px-3 py-1 text-xs font-medium text-primary-600 border border-primary-100"><%= d %></span>
            <% }); %>
          </div>
        </div>
      <% } %>
    </div>

    <div class="flex items-center justify-end space-x-3">
      <a href="/dashboard" class="btn-secondary">Cancel</a>
      <button type="submit" class="btn-primary">Save Configuration</button>
    </div>
  </form>

  <div class="card p-6">
    <h2 class="text-lg font-semibold text-sidebar-text mb-1">Registration Flow</h2>
    <div class="text-sm text-sidebar-muted space-y-2">
      <p>1. A new user registers with an email address matching an allowed domain (if restrictions are configured)</p>
      <p>2. The account is created with <strong>Pending</strong> status and cannot log in until approved</p>
      <p>3. An administrator must approve or deny the user from the <a href="/admin/users" class="text-primary-500 hover:text-primary-600 font-medium">User Management</a> page</p>
      <p>4. The first user to register is automatically approved as an admin</p>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
