<%- include('../partials/header', { title: 'Print Request' }) %>
<%- include('../partials/navbar') %>
<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold text-sidebar-text">Request: <%= request.requestNumber %></h1>
    <div class="flex items-center space-x-2">
      <button id="printBtn" class="btn-primary">
        <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
        Print
      </button>
      <% if (request.pdfPath) { %>
        <a href="/requests/<%= request._id %>/pdf" target="_blank" class="btn-secondary">Download PDF</a>
      <% } %>
    </div>
  </div>

  <div class="card p-6">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
      <div>
        <p class="text-xs text-sidebar-muted uppercase tracking-wider">Status</p>
        <% if (request.status === 'pending') { %>
          <span class="badge-pending mt-1">Pending</span>
        <% } else if (request.status === 'fulfilled') { %>
          <span class="badge-fulfilled mt-1">Fulfilled</span>
        <% } else if (request.status === 'dispatched') { %>
          <span class="badge-dispatched mt-1">Dispatched</span>
        <% } %>
      </div>
      <div>
        <p class="text-xs text-sidebar-muted uppercase tracking-wider">Supplier</p>
        <p class="font-medium mt-1"><%= request.supplier || 'N/A' %></p>
      </div>
      <div>
        <p class="text-xs text-sidebar-muted uppercase tracking-wider">Depot Site</p>
        <p class="font-medium mt-1"><%= request.depotSite ? request.depotSite.name : 'N/A' %></p>
      </div>
      <div>
        <p class="text-xs text-sidebar-muted uppercase tracking-wider">Created By</p>
        <p class="font-medium mt-1"><%= request.createdBy ? request.createdBy.name : 'Unknown' %></p>
      </div>
      <div>
        <p class="text-xs text-sidebar-muted uppercase tracking-wider">Date Planned</p>
        <p class="font-medium mt-1"><%= request.plannedDate ? new Date(request.plannedDate).toLocaleDateString('en-GB') : '-' %></p>
      </div>
      <% if (request.status !== 'pending') { %>
        <div>
          <p class="text-xs text-sidebar-muted uppercase tracking-wider">Fulfilled By</p>
          <p class="font-medium mt-1"><%= request.fulfilledBy ? request.fulfilledBy.name : 'Unknown' %></p>
        </div>
        <% if (request.boxNumber) { %>
          <div>
            <p class="text-xs text-sidebar-muted uppercase tracking-wider">Box Number</p>
            <p class="font-medium mt-1"><%= request.boxNumber %></p>
          </div>
        <% } %>
        <% if (request.bayNumber) { %>
          <div>
            <p class="text-xs text-sidebar-muted uppercase tracking-wider">Bay Number</p>
            <p class="font-medium mt-1"><%= request.bayNumber %></p>
          </div>
        <% } %>
      <% } %>
    </div>
  </div>

  <div class="card">
    <div class="px-6 py-4 border-b border-surface-border">
      <h2 class="text-lg font-semibold text-sidebar-text">Equipment Allocation</h2>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="bg-surface text-left">
            <th class="px-6 py-3 font-medium text-sidebar-muted text-xs uppercase tracking-wider">Equipment Type</th>
            <th class="px-6 py-3 font-medium text-sidebar-muted text-xs uppercase tracking-wider">Quantity</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-surface-border">
          <% if (request.equipments && request.equipments.length > 0) { %>
            <% request.equipments.forEach(function(eq) { %>
              <tr>
                <td class="px-6 py-4"><%= eq.equipmentType ? eq.equipmentType.name : 'Unknown' %></td>
                <td class="px-6 py-4 font-medium"><%= eq.quantity %></td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="2" class="px-6 py-4 text-sidebar-muted">No equipment allocated</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="card p-6">
    <h2 class="text-lg font-semibold text-sidebar-text mb-4 text-center">Dispatch Barcode</h2>
    <div class="flex justify-center">
      <div class="border-2 border-gray-300 rounded-lg p-6 text-center" style="min-width: 200px;">
        <p class="text-2xl font-mono font-bold text-sidebar-text tracking-widest"><%= request.requestNumber %></p>
        <p class="text-xs text-sidebar-muted mt-2">Scan at security gate to dispatch</p>
      </div>
    </div>
  </div>

  <p class="text-center text-xs text-sidebar-muted">
    Created: <%= new Date(request.createdAt).toLocaleString('en-GB') %>
  </p>
</div>
<%- include('../partials/footer') %>
<script src="/js/print.js"></script>
