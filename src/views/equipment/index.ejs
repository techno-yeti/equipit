<%- include('../partials/header', { title: 'Equipment Types' }) %>
<%- include('../partials/navbar') %>
<div class="space-y-6">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-y-4 sm:gap-0">
    <div>
      <h1 class="page-title">Equipment Types</h1>
      <p class="page-subtitle">Manage equipment types used across the system</p>
    </div>
    <% if (['admin', 'manager'].includes(user.role)) { %>
      <a href="/equipment/create" class="btn-primary">
        <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        Add Equipment
      </a>
    <% } %>
  </div>

  <div class="card overflow-x-auto sm:overflow-hidden -mx-4 sm:mx-0">
    <table class="w-full text-sm table-auto sm:table-fixed">
      <thead>
        <tr class="bg-surface text-left">
          <th class="px-3 sm:px-6 py-3 font-medium text-sidebar-muted text-xs uppercase tracking-wider w-1/4">Name</th>
          <th class="px-3 sm:px-6 py-3 font-medium text-sidebar-muted text-xs uppercase tracking-wider">Description</th>
          <th class="px-3 sm:px-6 py-3 font-medium text-sidebar-muted text-xs uppercase tracking-wider w-28">Created</th>
          <th class="px-3 sm:px-6 py-3 font-medium text-sidebar-muted text-xs uppercase tracking-wider text-right whitespace-nowrap">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-surface-border">
        <% if (equipment && equipment.length > 0) { %>
          <% equipment.forEach(function(e) { %>
            <tr class="hover:bg-surface">
              <td class="px-3 sm:px-6 py-4 font-medium"><%= e.name %></td>
              <td class="px-3 sm:px-6 py-4 text-sidebar-muted"><%= e.description || '-' %></td>
              <td class="px-3 sm:px-6 py-4 text-sidebar-muted"><%= new Date(e.createdAt).toLocaleDateString('en-GB') %></td>
              <td class="px-3 sm:px-6 py-4 whitespace-nowrap">
                <div class="flex items-center justify-end space-x-2">
                  <% if (['admin', 'manager'].includes(user.role)) { %>
                    <a href="/equipment/<%= e._id %>/edit" class="btn-secondary !text-xs !px-3 !py-1.5">
                      <svg class="w-3.5 h-3.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                      Edit
                    </a>
                  <% } %>
                  <% if (['admin', 'manager'].includes(user.role)) { %>
                    <a href="/equipment/<%= e._id %>/delete" class="btn-danger !text-xs !px-3 !py-1.5">
                      <svg class="w-3.5 h-3.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                      Delete
                    </a>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="4" class="px-3 sm:px-6 py-8 text-center text-sidebar-muted">No equipment types defined yet.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../partials/footer') %>
