<%- include('../partials/header', { title: 'Requests' }) %>
<%- include('../partials/navbar') %>
<div class="space-y-6">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-y-4 sm:gap-0">
    <div>
      <h1 class="page-title">Requests</h1>
      <p class="page-subtitle">View and manage all equipment requests</p>
    </div>
    <div class="flex items-center">
      <% if (['admin', 'manager'].includes(user.role)) { %>
        <a href="/requests/create" class="btn-primary w-full sm:w-auto">
          <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
          New Request
        </a>
      <% } %>
    </div>
  </div>

  <div class="flex flex-wrap items-center gap-3">
    <form method="GET" action="/requests" class="flex flex-wrap items-center gap-2">
      <input type="text" name="search" value="<%= typeof search !== 'undefined' ? search : '' %>" placeholder="Search by ref" class="input-field text-sm font-mono w-full sm:w-40" maxlength="6">
      <select name="status" class="input-field text-sm w-full sm:w-auto">
        <option value="">All</option>
        <option value="pending" <%= typeof statusFilter !== 'undefined' && statusFilter === 'pending' ? 'selected' : '' %>>Unfulfilled</option>
        <option value="fulfilled" <%= typeof statusFilter !== 'undefined' && statusFilter === 'fulfilled' ? 'selected' : '' %>>Fulfilled</option>
        <option value="dispatched" <%= typeof statusFilter !== 'undefined' && statusFilter === 'dispatched' ? 'selected' : '' %>>Dispatched</option>
      </select>
      <button type="submit" class="btn-primary !text-xs !px-3 !py-1.5 w-full sm:w-auto">Search</button>
    </form>
    <% if ((typeof search !== 'undefined' && search) || (typeof statusFilter !== 'undefined' && statusFilter)) { %>
      <a href="/requests" class="text-sm text-primary-600 hover:text-primary-700 font-medium">Clear</a>
    <% } %>
  </div>

  <div class="card overflow-x-auto sm:overflow-hidden -mx-4 sm:mx-0">
    <table class="w-full text-sm">
      <thead>
        <tr class="bg-surface text-left">
          <th class="px-3 sm:px-6 py-3 font-medium text-sidebar-muted text-xs uppercase tracking-wider">Request #</th>
          <th class="px-3 sm:px-6 py-3 font-medium text-sidebar-muted text-xs uppercase tracking-wider">Supplier</th>
          <th class="px-3 sm:px-6 py-3 font-medium text-sidebar-muted text-xs uppercase tracking-wider">Status</th>
          <th class="px-3 sm:px-6 py-3 font-medium text-sidebar-muted text-xs uppercase tracking-wider">Depot</th>
          <th class="px-3 sm:px-6 py-3 font-medium text-sidebar-muted text-xs uppercase tracking-wider">Created By</th>
          <th class="px-3 sm:px-6 py-3 font-medium text-sidebar-muted text-xs uppercase tracking-wider">Fulfilled By</th>
          <th class="px-3 sm:px-6 py-3 font-medium text-sidebar-muted text-xs uppercase tracking-wider">Created</th>
          <th class="px-3 sm:px-6 py-3 font-medium text-sidebar-muted text-xs uppercase tracking-wider">Planned</th>
          <th class="px-3 sm:px-6 py-3 font-medium text-sidebar-muted text-xs uppercase tracking-wider">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-surface-border">
        <% if (requests && requests.length > 0) { %>
          <% requests.forEach(function(r) { %>
            <tr class="hover:bg-surface">
              <td class="px-3 sm:px-6 py-4 font-mono font-bold"><%= r.requestNumber %></td>
              <td class="px-3 sm:px-6 py-4"><%= r.supplier || 'N/A' %></td>
              <td class="px-3 sm:px-6 py-4">
                <% if (r.status === 'pending') { %>
                  <span class="badge-pending">Pending</span>
                <% } else if (r.status === 'fulfilled') { %>
                  <span class="badge-fulfilled">Fulfilled</span>
                <% } else if (r.status === 'dispatched') { %>
                  <span class="badge-dispatched">Dispatched</span>
                <% } %>
              </td>
              <td class="px-3 sm:px-6 py-4"><%= r.depotSite ? r.depotSite.name : '-' %></td>
              <td class="px-3 sm:px-6 py-4"><%= r.createdBy ? r.createdBy.name : 'Unknown' %></td>
              <td class="px-3 sm:px-6 py-4"><%= r.fulfilledBy ? r.fulfilledBy.name : '-' %></td>
              <td class="px-3 sm:px-6 py-4 text-sidebar-muted"><%= new Date(r.createdAt).toLocaleDateString('en-GB') %></td>
              <td class="px-3 sm:px-6 py-4 text-sidebar-muted"><%= r.plannedDate ? new Date(r.plannedDate).toLocaleDateString('en-GB') : '-' %></td>
              <td class="px-3 sm:px-6 py-4">
                <div class="flex items-center space-x-2">
                  <% if (r.pdfPath) { %>
                      <a href="/requests/<%= r._id %>/pdf" target="_blank" class="btn-secondary !text-xs !px-3 !py-1.5">
                        <svg class="w-3.5 h-3.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                        View
                      </a>
                    <% } %>
                  <% if (r.status === 'pending' && ['admin', 'manager', 'user'].includes(user.role)) { %>
                    <a href="/requests/<%= r._id %>/fulfill" class="btn-primary !text-xs !px-3 !py-1.5">
                      <svg class="w-3.5 h-3.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                      Fulfill
                    </a>
                  <% } %>
                  <% if (r.status === 'fulfilled' && ['admin', 'manager', 'user'].includes(user.role)) { %>
                    <a href="/requests/<%= r._id %>/dispatch-note" class="btn-secondary !text-xs !px-3 !py-1.5">
                      <svg class="w-3.5 h-3.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                      Edit
                    </a>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="9" class="px-3 sm:px-6 py-8 text-center text-sidebar-muted">No requests found.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../partials/footer') %>
