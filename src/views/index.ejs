          <div class="w-16 h-16 bg-white/20 backdrop-blur rounded-2xl flex items-center justify-center shadow-lg shadow-black/10">
            <span class="text-white font-bold text-3xl">E</span>
          </div>
          <h1 class="text-5xl md:text-7xl font-bold text-white tracking-tight">Equipit</h1>
        </div>
        <p class="text-xl md:text-2xl text-primary-100 mb-4 font-light">Warehouse Equipment Management System</p>
        <p class="text-primary-200 max-w-2xl mx-auto mb-10 text-lg">
          Streamline your warehouse operations — manage equipment types, create trailer configurations,
          assign templates, track requests, and dispatch loads from gate to destination.
        </p>
        <div class="flex items-center justify-center space-x-4">
          <a href="/register" class="inline-flex items-center space-x-2 bg-white text-primary-700 font-semibold px-8 py-3.5 rounded-xl shadow-lg shadow-black/10 hover:bg-primary-50 transition-colors !text-base">
