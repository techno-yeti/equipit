<%- include('../partials/header', { title: template ? 'Edit Template' : 'Add Template' }) %>
<%- include('../partials/navbar') %>
<div class="max-w-2xl mx-auto">
  <div class="card p-8">
    <h1 class="text-2xl font-bold text-sidebar-text mb-2"><%= template ? 'Edit Template' : 'Add Template' %></h1>
    <p class="text-sidebar-muted text-sm mb-6"><%= template ? 'Update the template configuration' : 'Create a new equipment template for a supplier' %></p>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="mb-4 p-3 bg-red-50 border border-red-200 rounded-lg" role="alert">
        <p class="text-red-700 text-sm"><%= error %></p>
      </div>
    <% } %>

    <form action="<%= template ? '/templates/' + template._id + '/edit' : '/templates/create' %>" method="POST" class="space-y-4">
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label for="name" class="label">Template Name</label>
          <input type="text" id="name" name="name" class="input-field" value="<%= template ? template.name : '' %>" placeholder="e.g. Standard Load" required>
        </div>
        <div>
          <label for="supplier" class="label">Supplier (optional)</label>
          <input type="text" id="supplier" name="supplier" class="input-field" value="<%= template ? template.supplier : '' %>" placeholder="e.g. Acme Corp">
        </div>
      </div>

      <div>
        <label class="label">Equipment Allocation</label>
        <div id="equipmentRows" class="space-y-2">
          <% if (template && template.equipments && template.equipments.length > 0) { %>
            <% template.equipments.forEach(function(eq) { %>
              <div class="flex items-center space-x-2">
                <select name="equipmentType[]" class="input-field">
                  <option value="">Select equipment</option>
                  <% equipmentTypes.forEach(function(e) { %>
                    <option value="<%= e._id %>" <%= eq.equipmentType && eq.equipmentType._id && eq.equipmentType._id.toString() === e._id.toString() ? 'selected' : '' %>><%= e.name %></option>
                  <% }); %>
                </select>
                <input type="number" name="quantity[]" class="input-field w-24" placeholder="Qty" min="0" value="<%= eq.quantity %>">
                <button type="button" class="remove-equipment-btn text-red-500 hover:text-red-700 p-1">&times;</button>
              </div>
            <% }); %>
          <% } else { %>
            <div class="flex items-center space-x-2">
              <select name="equipmentType[]" class="input-field">
                <option value="">Select equipment</option>
                <% equipmentTypes.forEach(function(e) { %>
                  <option value="<%= e._id %>"><%= e.name %></option>
                <% }); %>
              </select>
              <input type="number" name="quantity[]" class="input-field w-24" placeholder="Qty" min="0">
              <button type="button" class="remove-equipment-btn text-red-500 hover:text-red-700 p-1">&times;</button>
            </div>
          <% } %>
        </div>
        <button type="button" id="addEquipmentBtn" class="text-primary-600 hover:text-primary-700 text-sm font-medium mt-2">+ Add Equipment</button>
      </div>

      <div class="flex items-center justify-end space-x-3 pt-4 border-t border-surface-border">
        <a href="/templates" class="btn-secondary">Cancel</a>
        <button type="submit" class="btn-primary"><%= template ? 'Update' : 'Create' %></button>
      </div>
    </form>
  </div>
</div>

<script src="/js/equipment-rows.js"></script>
<%- include('../partials/footer') %>
