<%- include('../partials/header', { title: 'Templates' }) %>
<%- include('../partials/navbar') %>
<div class="space-y-6">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-y-4 sm:gap-0">
    <div>
      <h1 class="page-title">Templates</h1>
      <p class="page-subtitle">Create and manage equipment templates for suppliers</p>
    </div>
    <% if (['admin', 'manager'].includes(user.role)) { %>
      <a href="/templates/create" class="btn-primary">
        <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        Add Template
      </a>
    <% } %>
  </div>

  <div class="grid gap-4">
    <% if (templates && templates.length > 0) { %>
      <% templates.forEach(function(t) { %>
        <div class="card p-4 sm:p-6">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-y-3 sm:gap-0 mb-4">
            <div>
              <h3 class="text-lg font-semibold text-sidebar-text"><%= t.name %></h3>
              <p class="text-sidebar-muted text-sm">Supplier: <%= t.supplier || 'N/A' %></p>
            </div>
            <div class="flex items-center space-x-2">
              <% if (['admin', 'manager'].includes(user.role)) { %>
                <a href="/templates/<%= t._id %>/edit" class="btn-secondary !text-xs !px-3 !py-1.5">
                  <svg class="w-3.5 h-3.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                  Edit
                </a>
              <% } %>
              <a href="/templates/<%= t._id %>/delete" class="btn-danger !text-xs !px-3 !py-1.5">
                  <svg class="w-3.5 h-3.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                  Delete
                </a>
            </div>
          </div>
          <div class="border-t border-surface-border pt-4">
            <table class="w-full text-sm">
              <thead>
                <tr class="text-left text-sidebar-muted text-xs uppercase tracking-wider">
                  <th class="pb-2 font-medium">Equipment</th>
                  <th class="pb-2 font-medium text-right">Quantity</th>
                </tr>
              </thead>
              <tbody>
                <% t.equipments.forEach(function(eq) { %>
                  <tr>
                    <td class="py-1"><%= eq.equipmentType ? eq.equipmentType.name : 'Unknown' %></td>
                    <td class="py-1 font-medium text-right"><%= eq.quantity %></td>
                  </tr>
                <% }); %>
                <% if (t.equipments.length === 0) { %>
                  <tr>
                    <td colspan="2" class="py-2 text-sidebar-muted italic">No equipment configured</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      <% }); %>
    <% } else { %>
      <div class="card p-8 text-center text-sidebar-muted">No templates defined yet.</div>
    <% } %>
  </div>
</div>
<%- include('../partials/footer') %>
