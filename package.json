{
  "name": "equipit",
  "version": "1.0.0",
  "description": "Warehouse equipment management system",
  "main": "src/server.js",
  "scripts": {
    "start": "npm run build:css && NODE_ENV=production node src/server.js",
    "dev": "concurrently \"npx tailwindcss -i ./src/public/css/input.css -o ./src/public/css/app.css --watch\" \"nodemon src/server.js\"",
    "build:css": "npx tailwindcss -i ./src/public/css/input.css -o ./src/public/css/app.css --minify",
    "test": "npx jest --forceExit",
    "seed": "node src/seed.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.2",
    "morgan": "^1.10.0",
    "pdfkit": "^0.15.2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17"
  }
}
