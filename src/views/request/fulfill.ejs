<%- include('../partials/header', { title: 'Fulfill Request' }) %>
<%- include('../partials/navbar') %>
<div class="max-w-2xl mx-auto">
  <div class="card p-8">
    <h1 class="text-2xl font-bold text-sidebar-text mb-2">Fulfill Request</h1>
    <p class="text-sidebar-muted text-sm mb-6">Record storage location and confirm fulfillment.</p>

    <%
      var now = new Date();
      var localDate = now.getFullYear() + '-' + String(now.getMonth() + 1).padStart(2, '0') + '-' + String(now.getDate()).padStart(2, '0');
    %>

    <div id="fulfill-error" class="hidden mb-4 p-3 bg-red-50 border border-red-200 rounded-lg" role="alert">
      <p class="text-red-700 text-sm">Please enter both a Box Number and a Bay Number before fulfilling.</p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="mb-4 p-3 bg-red-50 border border-red-200 rounded-lg" role="alert">
        <p class="text-red-700 text-sm"><%= error %></p>
      </div>
    <% } %>

    <div class="bg-surface rounded-lg p-4 mb-6 space-y-2 text-sm">
      <div class="flex justify-between">
        <span class="text-sidebar-muted">Request #</span>
        <span class="font-mono font-bold text-sidebar-text"><%= request.requestNumber %></span>
      </div>
      <div class="flex justify-between">
        <span class="text-sidebar-muted">Supplier</span>
        <span class="font-medium text-sidebar-text"><%= request.supplier || 'N/A' %></span>
      </div>
      <div class="flex justify-between">
        <span class="text-sidebar-muted">Depot Site</span>
        <span class="font-medium text-sidebar-text"><%= request.depotSite ? request.depotSite.name : 'N/A' %></span>
      </div>
      <div class="flex justify-between">
        <span class="text-sidebar-muted">Created By</span>
        <span class="font-medium text-sidebar-text"><%= request.createdBy ? request.createdBy.name : 'Unknown' %></span>
      </div>
      <div class="flex justify-between">
        <span class="text-sidebar-muted">Fulfilled By</span>
        <span class="font-medium text-sidebar-text"><%= user.name %></span>
      </div>
    </div>

    <form action="/requests/<%= request._id %>/fulfill" method="POST" class="space-y-4">
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label for="boxNumber" class="label">Box Number</label>
          <input type="text" id="boxNumber" name="boxNumber" class="input-field" placeholder="e.g. BX-101" maxlength="50">
        </div>
        <div>
          <label for="bayNumber" class="label">Bay Number</label>
          <input type="text" id="bayNumber" name="bayNumber" class="input-field" placeholder="e.g. BAY-12" maxlength="50">
        </div>
      </div>

      <div>
        <label class="label">Fulfillment Date</label>
        <p class="text-sidebar-muted font-medium"><%= localDate %></p>
        <input type="hidden" name="fulfillmentDate" value="<%= localDate %>">
      </div>

      <div class="border-t border-surface-border pt-4">
        <h3 class="text-sm font-semibold text-sidebar-text mb-2">Equipment Allocation</h3>
        <table class="w-full text-sm">
          <thead>
            <tr class="text-left text-sidebar-muted text-xs uppercase tracking-wider">
              <th class="pb-2 font-medium">Equipment Type</th>
              <th class="pb-2 font-medium">Quantity</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-border">
            <% if (request.equipments && request.equipments.length > 0) { %>
              <% request.equipments.forEach(function(eq) { %>
                <tr>
                  <td class="py-1.5"><%= eq.equipmentType ? eq.equipmentType.name : 'Unknown' %></td>
                  <td class="py-1.5 font-medium"><%= eq.quantity %></td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="2" class="py-2 text-sidebar-muted italic">No equipment allocated</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <div class="flex items-center justify-end space-x-3 pt-4 border-t border-surface-border">
        <a href="/requests" class="btn-secondary">Cancel</a>
        <button type="submit" class="btn-primary">
          <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          Confirm Fulfillment
        </button>
      </div>
    </form>
  </div>
</div>
<script src="/js/sanitize-location.js" defer></script>
<script src="/js/validate-fulfill.js" defer></script>
<%- include('../partials/footer') %>
